# Placeholder only. Copy this file to wrangler.toml, fill your own ids,
# and do not commit wrangler.toml.
#
# The stand-up path for this repository is the base-case server:
#   pip install -r requirements.txt && python server.py
# This example is not a production Worker and contains no account bindings.
# This tree does not include worker.py.

name = "your-worker-name"
main = "worker.py"
compatibility_date = "2026-09-18"

